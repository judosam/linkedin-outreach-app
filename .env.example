# ==== Outreach Command Center — copy to .env and fill in ====

# --- Web app auth ---
OCC_ADMIN_USERNAME=admin
OCC_ADMIN_PASSWORD=

# --- Google Sheets (pipeline database) ---
MASTER_SHEET_ID=1xdZtLvQZ6cshlI75-XuLU7dSuniL-2NIqVZ8mQYHUxk
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials.json

# --- Email notifications (Gmail SMTP) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
NOTIFY_SENDER_EMAIL=samuel@vservesolution.com
NOTIFY_SENDER_APP_PASSWORD=your-gmail-app-password
NOTIFY_RECIPIENT_EMAILS=samuel@vservesolution.com,ranganathan@vservesolution.com,nandhini@vservesolution.com,prabhu@vservesolution.com

# --- Google Chat webhook ---
GCHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/XXXX/messages?key=XXXX&token=XXXX

# --- Optional: set to 1 to make pipeline jobs skip LinkedIn POSTs & sheet writes ---
OCC_DRY_RUN=

# --- Follow-up timing (days before each follow-up, per track) ---
# OCC_INVITE_FU_DAYS=3,5,7
# OCC_INMAIL_FU_DAYS=3,5,7
