[Unit]
Description=Outreach Command Center (Campaign Manager)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/outreach
EnvironmentFile=/opt/outreach/.env
ExecStart=/opt/outreach/venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5s
StandardOutput=append:/var/log/outreach.log
StandardError=append:/var/log/outreach.err.log

[Install]
WantedBy=multi-user.target
